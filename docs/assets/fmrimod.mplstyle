font.family: sans-serif
font.sans-serif: DejaVu Sans
font.size: 11
axes.titlesize: 13
axes.titleweight: normal
axes.titlepad: 16
axes.labelsize: 11
axes.labelcolor: 202d31
axes.edgecolor: aeb8b7
axes.linewidth: 0.7
axes.spines.top: False
axes.spines.right: False
axes.prop_cycle: cycler('color', ['24786f', 'c26143', '657aa4', 'aa8b38', '935d7a'])
axes.axisbelow: True
figure.facecolor: ffffff
axes.facecolor: ffffff
text.color: 202d31
xtick.color: 475a5d
ytick.color: 475a5d
xtick.labelsize: 10
ytick.labelsize: 10
grid.color: dce2df
grid.linewidth: 0.6
legend.frameon: False
legend.fontsize: 10
lines.linewidth: 2
savefig.bbox: tight
savefig.pad_inches: 0.15
svg.fonttype: none
